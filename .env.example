DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgresql://mailuser:mailpass@db:5432/mailautomation
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
DEFAULT_FROM_EMAIL=no-reply@example.com
FRONTEND_URL=http://localhost:5173
FIELD_ENCRYPTION_KEY=replace-with-fernet-key
EMAIL_BATCH_SIZE=200
EMAIL_SEND_DELAY_SECONDS=0.2
MAX_UPLOAD_SIZE_BYTES=26214400
SECURE_HSTS_SECONDS=31536000

# Optional automatic superuser setup
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-secure-password
